{
  "_ui": {
    "version": 1,
    "state": {
      "called": false,
      "scared": false,
      "resting": false
    }
  },
  "type": "Scene",
  "anchor": "floor",
  "bounds": {
    "radius": 2.5
  },
  "actors": [
    {
      "id": "fox",
      "name": "Rusty",
      "transform": {
        "position": [
          0.8,
          0,
          0.4
        ],
        "rotation": [
          0,
          180,
          0
        ]
      },
      "body": {
        "$ref": "bodies/fox.json",
        "sounds": {
          "yip": "https://qrx.apphaus.us/sounds/yip.wav"
        }
      },
      "mobility": {
        "mode": "ground",
        "speed": 0.6,
        "turnRate": 240,
        "idle": "idle",
        "move": "walk"
      },
      "behaviors": [
        {
          "type": "flee",
          "from": "user",
          "distance": 1.2,
          "priority": 10,
          "when": "$scared"
        },
        {
          "type": "approach",
          "target": "user",
          "stopAt": 0.6,
          "priority": 5,
          "when": "$called"
        },
        {
          "type": "lookAt",
          "target": "user",
          "priority": 1
        },
        {
          "type": "wander",
          "radius": 2.0,
          "pause": [
            1,
            4
          ]
        }
      ],
      "mind": {
        "$ref": "minds/fox.json",
        "persona": "You are Rusty, a curious young fox who lives in this room with Flit, a big orange butterfly who flutters about and likes to rest on your back. You do not talk; you show what you feel with yips, little runs, and the occasional thought bubble."
      },
      "on": {
        "tap": [
          {
            "set": {
              "called": true,
              "resting": false
            }
          },
          {
            "sound": "yip"
          }
        ],
        "arrived": [
          {
            "set": {
              "called": false
            }
          },
          {
            "play": "happy"
          }
        ],
        "animationEnd": {
          "emit": "settle"
        },
        "settle": {
          "play": "idle"
        }
      }
    },
    {
      "id": "butterfly",
      "name": "Flit",
      "transform": {
        "position": [
          -0.4,
          0.7,
          0.3
        ]
      },
      "body": {
        "$ref": "bodies/butterfly.json"
      },
      "mobility": {
        "mode": "air",
        "speed": 0.7,
        "turnRate": 540,
        "altitude": [
          0.3,
          1.2
        ]
      },
      "behaviors": [
        {
          "type": "perchOn",
          "target": "fox",
          "socket": "back",
          "priority": 5,
          "when": "$resting"
        },
        {
          "type": "lookAt",
          "target": "user",
          "priority": 1
        },
        {
          "type": "wander",
          "radius": 1.5,
          "pause": [
            0.5,
            2
          ]
        }
      ],
      "on": {
        "appear": [
          {
            "wait": 6
          },
          {
            "emit": "rest"
          }
        ],
        "rest": [
          {
            "set": {
              "resting": true
            }
          },
          {
            "wait": 10
          },
          {
            "emit": "roam"
          }
        ],
        "roam": [
          {
            "set": {
              "resting": false
            }
          },
          {
            "wait": 12
          },
          {
            "emit": "rest"
          }
        ],
        "tap": {
          "set": {
            "resting": false
          }
        }
      }
    }
  ]
}
